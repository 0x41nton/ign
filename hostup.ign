  "systemd": {
    "units": [
      {
        "contents": "[Unit]\nDescription=Install qemu-guest-agent\nWants=network-online.target\nAfter=network-online.target\nBefore=zincati.service\n[Service]\nType=oneshot\nRemainAfterExit=yes\nTimeoutStartSec=900\nExecStart=/bin/sh -c 'rpm -q qemu-guest-agent \u003e/dev/null || rpm-ostree install --apply-live --allow-inactive --idempotent qemu-guest-agent'\nExecStart=/usr/bin/systemctl daemon-reload\nExecStart=-/usr/bin/systemctl start qemu-guest-agent.service\n[Install]\nWantedBy=multi-user.target\n",
        "enabled": true,
        "name": "layer-packages.service"
      }
    ]
