  "systemd": {
    "units": [
      {
        "contents": "[Unit]\nDescription=Host input firewall\nBefore=network-pre.target sshd.service\nWants=network-pre.target\n[Service]\nType=oneshot\nRemainAfterExit=yes\nExecStart=/usr/sbin/nft -f /etc/nftables/host.nft\nExecReload=/usr/sbin/nft -f /etc/nftables/host.nft\nExecStop=/usr/sbin/nft delete table inet host\n[Install]\nWantedBy=multi-user.target\n",
