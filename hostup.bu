# Base Fedora CoreOS config for a Hostup (KVM) VPS.
# Build:  butane --strict --pretty --files-dir . hostup.bu > hostup.ign
#         (--files-dir: the netbird/ files are pulled in with `local:`)
# Embed:  coreos-installer iso customize --dest-device /dev/vda \
#           --dest-ignition hostup.ign -o fcos-hostup.iso fedora-coreos-*-live*.iso
variant: fcos
version: 1.5.0

passwd:
  users:
    - name: core
      ssh_authorized_keys:
        - sk-ssh-ed25519@openssh.com AAAAGnNrLXNzaC1lZDI1NTE5QG9wZW5zc2guY29tAAAAICBvX+kmHBmnmms5JXvmCWtAjYh8zguva+lpeO4tKuHoAAAABHNzaDo=

    # Rootless user for the NetBird pod. No login; its quadlets live in
    # /etc/containers/systemd/users/1001/.
    - name: netbird
      uid: 1001
      shell: /usr/sbin/nologin

storage:
  directories:
    - path: /etc/netbird
      mode: 0700
      user: { name: netbird }
      group: { name: netbird }
    - path: /etc/containers/systemd/users/1001
      mode: 0755

  links:
    # Lets the netbird user's AutoUpdate=registry images update (daily).
    - path: /etc/systemd/user/timers.target.wants/podman-auto-update.timer
      target: /usr/lib/systemd/user/podman-auto-update.timer

  files:
    # --- NetBird (rootless pod as user netbird) ---
    # Start the netbird user's services at boot without a login.
    - path: /var/lib/systemd/linger/netbird
      mode: 0644
    # Rootless pasta binds the published ports on the host; allow 80 and 443.
    - path: /etc/sysctl.d/90-unprivileged-ports.conf
      mode: 0644
      contents:
        inline: net.ipv4.ip_unprivileged_port_start=80
    - path: /etc/containers/systemd/users/1001/caddy.container
      mode: 0644
      contents: { local: netbird_new/quadlets/caddy.container }
    - path: /etc/containers/systemd/users/1001/netbird-server.container
      mode: 0644
      contents: { local: netbird_new/quadlets/netbird-server.container }
    - path: /etc/containers/systemd/users/1001/netbird-dashboard.container
      mode: 0644
      contents: { local: netbird_new/quadlets/netbird-dashboard.container }
    - path: /etc/containers/systemd/users/1001/netbird-data.volume
      mode: 0644
      contents: { local: netbird_new/quadlets/netbird-data.volume }
    - path: /etc/containers/systemd/users/1001/caddy-data.volume
      mode: 0644
      contents: { local: netbird_new/quadlets/caddy-data.volume }
    # Owned by netbird so the rootless container can relabel them (:z).
    - path: /etc/netbird/Caddyfile
      mode: 0644
      user: { name: netbird }
      group: { name: netbird }
      contents: { local: netbird_new/files/Caddyfile }
    - path: /etc/netbird/dashboard.env
      mode: 0600
      user: { name: netbird }
      group: { name: netbird }
      contents: { local: netbird_new/files/dashboard.env }
    # --- end NetBird ---

    - path: /etc/hostname
      mode: 0644
      contents:
        inline: edge-proxy

    # Key-only SSH, and only FIDO2 (sk-) keys. sshd requires a touch on
    # the key by default.
    - path: /etc/ssh/sshd_config.d/10-hardening.conf
      mode: 0644
      contents:
        inline: |
          PermitRootLogin no
          PasswordAuthentication no
          KbdInteractiveAuthentication no
          AuthenticationMethods publickey
          PubkeyAcceptedAlgorithms sk-ssh-ed25519@openssh.com,sk-ecdsa-sha2-nistp256@openssh.com
          AllowUsers core
          MaxAuthTries 3
          LoginGraceTime 20
          X11Forwarding no

    # Updates: Zincati reboots only inside this window (UTC).
    - path: /etc/zincati/config.d/55-updates-strategy.toml
      mode: 0644
      contents:
        inline: |
          [updates]
          strategy = "periodic"
          [[updates.periodic.window]]
          days = [ "Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun" ]
          start_time = "03:00"
          length_minutes = 60

    # Compressed swap in RAM, for small VPS plans.
    - path: /etc/systemd/zram-generator.conf
      mode: 0644
      contents:
        inline: |
          [zram0]
          zram-size = min(ram / 2, 4096)

systemd:
  units:
    # qemu-guest-agent
    - name: layer-packages.service
      enabled: true
      contents: |
        [Unit]
        Description=Install qemu-guest-agent
        Wants=network-online.target
        After=network-online.target
        Before=zincati.service
        [Service]
        Type=oneshot
        RemainAfterExit=yes
        TimeoutStartSec=900
        ExecStart=/bin/sh -c 'rpm -q qemu-guest-agent >/dev/null || rpm-ostree install --apply-live --allow-inactive --idempotent qemu-guest-agent'
        ExecStart=/usr/bin/systemctl daemon-reload
        ExecStart=-/usr/bin/systemctl start qemu-guest-agent.service
        [Install]
        WantedBy=multi-user.target
